# ============================================
# Weather Station — Environment Variables
# ============================================
# Copia este archivo como .env y rellena los valores
# cp .env.example .env

# --- Base de datos ---
DB_PASSWORD=cambia_esto_por_una_contraseña_segura

# --- API ---
# Genera un token seguro: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=cambia_esto_por_un_token_seguro

# --- Dominio ---
# Tu dominio o subdominio apuntando a la IP de Oracle Cloud
DOMAIN=meteo.tu-dominio.com

# --- CORS ---
# Orígenes permitidos (separados por coma). Usa * solo para desarrollo
ALLOWED_ORIGINS=https://meteo.tu-dominio.com

# --- Zona horaria ---
TZ=Europe/Madrid
