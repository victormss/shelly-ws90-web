# ============================================
# Weather Station — Staging Environment Variables
# ============================================
# Copia este archivo como .env en el servidor staging
# y rellena los valores antes de desplegar

# --- Base de datos ---
DB_PASSWORD=cambia_esto_por_una_contraseña_segura

# --- API ---
# Genera un token seguro: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=cambia_esto_por_un_token_seguro

# --- Dominio ---
DOMAIN=meteotest.victorsantos.com.es

# --- CORS ---
ALLOWED_ORIGINS=https://meteotest.victorsantos.com.es

# --- Zona horaria ---
TZ=Europe/Madrid

# --- Repositorio GitHub (para pull de imágenes) ---
GITHUB_REPOSITORY=victormss/shelly-ws90-web
